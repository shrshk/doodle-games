{
  "name": "doodle-games",
  "private": true,
  "packageManager": "pnpm@10.34.6",
  "scripts": {
    "dev": "turbo run dev --filter=@snakes-doodle/web",
    "build": "turbo run build",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint && node games/snakes-and-ladders/scripts/check-engine-purity.mjs",
    "balance": "pnpm --filter @snakes-doodle/engine balance",
    "print:boards": "pnpm --filter @snakes-doodle/web print:boards",
    "e2e": "playwright test -c games/snakes-and-ladders/playwright.config.ts",
    "start": "node games/snakes-and-ladders/apps/server/dist/index.js",
    "dev:server": "pnpm --filter @snakes-doodle/server dev"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "turbo": "2.8.21",
    "typescript": "5.6.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
