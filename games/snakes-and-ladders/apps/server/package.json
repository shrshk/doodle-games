{
  "name": "@snakes-doodle/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite build --watch",
    "build": "tsc -p tsconfig.json && vite build",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@colyseus/core": "0.18.18",
    "@colyseus/schema": "5.0.36",
    "@colyseus/ws-transport": "0.18.4",
    "@doodle-games/rooms": "workspace:*",
    "@snakes-doodle/boards": "workspace:*",
    "@snakes-doodle/engine": "workspace:*",
    "@snakes-doodle/protocol": "workspace:*"
  },
  "devDependencies": {
    "@colyseus/sdk": "0.18.5",
    "@colyseus/testing": "0.18.6",
    "@colyseus/tools": "0.18.9",
    "@types/node": "22.10.2",
    "typescript": "5.6.3",
    "vite": "5.4.21",
    "vitest": "2.1.9"
  }
}
